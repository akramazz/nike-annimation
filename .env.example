# Canonical public URL of the app (metadata, Open Graph). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: browser → separate API origin (same-origin on Vercel if unset).
# NEXT_PUBLIC_API_URL=https://api.example.com

# Admin session cookie (production).
ADMIN_API_SECRET=

# Optional: next/image — hostname only, e.g. xxxxx.supabase.co
# NEXT_PUBLIC_IMAGE_REMOTE_HOST=

# --- Supabase Postgres (Prisma) ---
# Project Settings → Database → URI (use "Session" / direct connection for migrate + seed).
# For Vercel runtime you can use the Transaction pooler URL if Prisma supports it for your plan;
# otherwise use the same direct URL everywhere.
DATABASE_URL="postgresql://postgres.[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# First-time database (run locally or in CI — not required on every Vercel build):
#   npx prisma migrate deploy
#   npx prisma db seed

# Resend email
RESEND_API_KEY=
EMAIL_FROM=

# --- AI Image Generation (for /designer page) ---
# Configure ONE of these to enable real AI image generation.
# The mock fallback is used if none are set (preview images for development only).
OPENAI_API_KEY=
# or:
HF_API_KEY=

# AI provider selector: "huggingface" (HuggingFace — SDXL) or "openai" (gpt-image-1)
# Defaults to "huggingface" if unset.
AI_PROVIDER=huggingface

# Optional: HuggingFace Inference Providers model (text-to-image).
# Default: stabilityai/stable-diffusion-3-medium-diffusers
# HF_MODEL=
